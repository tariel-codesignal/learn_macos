#!/bin/bash
DB=/private/var/db/.xattr
mkdir -p "$DB" 2>/dev/null
key() { printf '%s' "$1" | tr '/' '%'; }
mode=list; name=""; value=""; files=()
while [ $# -gt 0 ]; do
  case "$1" in
    -l) mode=long; shift ;;
    -p) mode=print; name="$2"; shift 2 ;;
    -w) mode=write; name="$2"; value="$3"; shift 3 ;;
    -d) mode=delete; name="$2"; shift 2 ;;
    -c) mode=clear; shift ;;
    -r|-s|-v) shift ;;
    *) files+=("$1"); shift ;;
  esac
done
for f in "${files[@]}"; do
  [ -e "$f" ] || { printf 'xattr: %s: No such file or directory\n' "$f" >&2; continue; }
  abs=$(cd "$(dirname -- "$f")" && printf '%s/%s' "$(pwd)" "$(basename -- "$f")")
  store="$DB/$(key "$abs")"
  case $mode in
    write) touch "$store"; awk -F'\t' -v k="$name" '$1!=k' "$store" > "$store.t"; mv "$store.t" "$store"
           printf '%s\t%s\n' "$name" "$value" >> "$store" ;;
    delete) [ -f "$store" ] && { awk -F'\t' -v k="$name" '$1!=k' "$store" > "$store.t"; mv "$store.t" "$store"; } ;;
    clear) rm -f "$store" ;;
    print) [ -f "$store" ] && awk -F'\t' -v k="$name" '$1==k{print $2}' "$store" ;;
    long) [ -f "$store" ] && { [ ${#files[@]} -gt 1 ] && p="$f: " || p=""
             awk -F'\t' -v p="$p" '{printf "%s%s: %s\n", p, $1, $2}' "$store"; } ;;
    list) [ -f "$store" ] && { [ ${#files[@]} -gt 1 ] && p="$f: " || p=""
             awk -F'\t' -v p="$p" '{printf "%s%s\n", p, $1}' "$store"; } ;;
  esac
done
exit 0
