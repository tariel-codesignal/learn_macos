#!/bin/bash
hw() {
cat <<'OUT'
Hardware:

    Hardware Overview:

      Model Name: MacBook Pro
      Model Identifier: Mac15,3
      Model Number: MTL73D/A
      Chip: Apple M3
      Total Number of Cores: 8 (4 performance and 4 efficiency)
      Memory: 16 GB
      System Firmware Version: 11881.121.1
      OS Loader Version: 11881.121.1
OUT
}
sw() {
cat <<'OUT'
Software:

    System Software Overview:

      System Version: macOS 15.5 (24F74)
      Kernel Version: Darwin 24.5.0
      Boot Volume: Macintosh HD
      Boot Mode: Normal
      Computer Name: Learner's MacBook Pro
      User Name: Learner (Learner)
      Secure Virtual Memory: Enabled
      System Integrity Protection: Enabled
OUT
}
case "$1" in
  SPHardwareDataType) hw ;;
  SPSoftwareDataType) sw ;;
  -listDataTypes) printf 'SPHardwareDataType\nSPSoftwareDataType\nSPStorageDataType\nSPNetworkDataType\nSPDisplaysDataType\n' ;;
  "") sw; printf '\n'; hw ;;
  *) printf 'system_profiler: unknown data type %s\n' "$1" >&2; exit 1 ;;
esac
